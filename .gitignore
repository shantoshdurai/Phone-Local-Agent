# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
.env

# Local backup files from in-place edits
*.orig
*.patch

# ── Secrets / signing ──────────────────────────────────────────────────────
# Never commit these. An API key in the repo (or worse, bundled as an asset)
# is one of the fastest ways to get an app pulled, and a leaked upload key
# lets someone else publish as you.
.env
.env.*
android/key.properties
*.jks
*.keystore
android/app/upload-keystore.jks

# ── Local tooling ──────────────────────────────────────────────────────────
# Permission-repair reports from the sandbox diagnostic.
.acl-recovery/

